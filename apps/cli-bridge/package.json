{
  "name": "@codex-complex-prompt/cli-bridge",
  "private": false,
  "version": "0.3.0",
  "description": "A browser Markdown editor connected to Codex UserPromptSubmit and Stop hooks.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nayounsang/codex-complex-prompt.git",
    "directory": "apps/cli-bridge"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/**",
    "!dist/**/*.test.*",
    "!dist/smoke.*",
    "web/dist/**",
    "README.md",
    "THIRD-PARTY-NOTICES.txt",
    "LICENSE"
  ],
  "bin": {
    "complex-prompt": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsx scripts/prepare-build.ts && tsc -p tsconfig.build.json && tsx scripts/build-package.ts",
    "prepack": "pnpm build",
    "smoke": "tsx src/smoke.ts",
    "package:smoke": "tsx scripts/package-smoke.ts"
  },
  "dependencies": {
    "open": "^10.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "esbuild": "^0.25.2",
    "@codex-complex-prompt/server": "workspace:*",
    "@codex-complex-prompt/protocol": "workspace:*",
    "@codex-complex-prompt/web": "workspace:*",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "ws": "^8.18.0"
  },
  "main": "dist/index.js",
  "keywords": [
    "codex",
    "cli",
    "prompt",
    "hooks"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/nayounsang/codex-complex-prompt/issues"
  },
  "homepage": "https://github.com/nayounsang/codex-complex-prompt#readme",
  "types": "./dist/index.d.ts"
}
