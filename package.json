{
  "name": "codex-complex-prompt",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "build": "turbo build",
    "package:smoke": "pnpm build && pnpm --filter @codex-complex-prompt/cli-bridge package:smoke",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @codex-complex-prompt/e2e test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "prettier": "^3.5.3",
    "turbo": "^2.5.6"
  }
}
